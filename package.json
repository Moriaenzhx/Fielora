{
  "name": "fielora",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "agent:performance": "python scripts/report-agent-performance.py",
    "dev": "pnpm build:core:debug && pnpm --filter @fielora/desktop start",
    "build": "pnpm typecheck && pnpm build:core:release && pnpm --filter @fielora/desktop package",
    "build:core:debug": "cargo build -p fielora-core",
    "build:core:release": "cargo build --release -p fielora-core",
    "contracts:generate": "cargo run -p fielora-contracts --example export_ts",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/contracts/generated",
    "contracts:verify-current": "node scripts/check-contracts-generated.mjs",
    "typecheck": "pnpm --filter @fielora/desktop typecheck",
    "lint": "pnpm --filter @fielora/desktop lint",
    "test": "pnpm test:ts && cargo test --workspace",
    "test:ts": "pnpm --filter @fielora/desktop test",
    "test:integration": "pnpm build:core:debug && node --test tests/integration/core.integration.test.mjs",
    "test:e2e": "pnpm build:core:debug && node tests/e2e/phase02-desktop-e2e.mjs dev",
    "test:e2e:browse": "pnpm build:core:debug && node tests/e2e/browse-slice01-e2e.mjs",
    "test:e2e:browse:packaged": "node tests/e2e/browse-slice01-e2e.mjs packaged",
    "test:e2e:phase04": "pnpm build:core:debug && node tests/e2e/phase04-desktop-e2e.mjs dev",
    "test:e2e:phase04:packaged": "node tests/e2e/phase04-desktop-e2e.mjs packaged",
    "test:e2e:desktop-foundation": "pnpm build:core:debug && node tests/e2e/desktop-foundation-e2e.mjs dev",
    "test:e2e:desktop-foundation:packaged": "node tests/e2e/desktop-foundation-e2e.mjs packaged",
    "test:e2e:project-navigation": "pnpm build:core:debug && node tests/e2e/project-navigation-e2e.mjs",
    "test:e2e:agent-codex-style": "node tests/e2e/agent-codex-style-execution-real-e2e.mjs",
    "test:e2e:appearance": "pnpm build:core:debug && node tests/e2e/appearance-settings-e2e.mjs",
    "probe:configured-providers": "pnpm build:core:debug && node scripts/probe-configured-providers.mjs",
    "test:eval:china-model": "node --test tests/eval/china-model-preflight.test.mjs",
    "eval:agent:china:preflight": "pnpm build:core:debug && cargo test -p fielora-model -p fielora-agent && pnpm test:eval:china-model && node scripts/eval-agent-china-preflight.mjs",
    "eval:agent:qwen:preflight": "pnpm eval:agent:china:preflight",
    "test:e2e:single-instance:packaged": "node tests/e2e/single-instance-e2e.mjs",
    "make:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-portable.ps1",
    "make:portable:phase03": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-phase03-portable.ps1",
    "make:portable:phase04": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-phase04-portable.ps1",
    "make:portable:agent": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-agent-portable.ps1",
    "test:packaged": "node tests/e2e/phase02-desktop-e2e.mjs packaged",
    "test:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-portable.ps1",
    "test:portable:phase03": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-phase03-portable.ps1",
    "test:portable:phase04": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-phase04-portable.ps1",
    "test:portable:agent": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-agent-portable.ps1",
    "audit:context": "node scripts/audit-context.mjs",
    "refresh:context": "node scripts/refresh-context-manifest.mjs",
    "verify:dev:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-development.ps1 -Lane Docs",
    "verify:dev:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-development.ps1 -Lane Ui",
    "verify:dev:core": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-development.ps1 -Lane Core",
    "verify:dev:cross": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-development.ps1 -Lane Cross",
    "verify:premerge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-development.ps1 -Lane PreMerge",
    "verify:phase01": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase01.ps1",
    "verify:phase02": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase02.ps1",
    "verify:phase03": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase03.ps1",
    "verify:phase04": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase04.ps1"
  }
}
